# ==============================================================================
# Visual Intelligence, Surveillance and Traffic Analytics (VISTA / NeuralGrid)
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual connection credentials.
# DO NOT commit your actual .env file with secrets into version control.

# ==============================================================================
# PostgreSQL + PostGIS Database Configuration
# ==============================================================================
# Hostname or IP of the PostgreSQL instance (local or hosted e.g. Supabase, RDS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=city_traffic
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# SSL Mode: 'disable' for local development, 'require' for hosted/cloud providers
DB_SSLMODE=disable

# ==============================================================================
# Redis Configuration (Streams & Pub/Sub Event Bus)
# ==============================================================================
# Hostname or IP of the Redis server (local or Redis Cloud)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL=false

